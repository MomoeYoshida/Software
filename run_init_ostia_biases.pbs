#!/bin/bash
#PBS -j oe
#PBS -m ae
#PBS -N initOSTIAbiases
#PBS -M momoe.yoshida@my.jcu.edu.au
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=1:mem=64gb
cd $PBS_O_WORKDIR
export SST_ENV=$PBS_O_WORKDIR

# Add this to all of your scripts
shopt -s expand_aliases
source /etc/profile.d/modules.sh

# Check variables supplied by submit_make_op_sst_workflow.sh
: "${YEAR:?ERROR: YEAR was not supplied to run_init_ostia_biases.pbs}"
: "${DAY_OF_YEAR:?ERROR: DAY_OF_YEAR was not supplied to run_init_ostia_biases.pbs}"

# YEAR must contain four digits.
if [[ ! "$YEAR" =~ ^[0-9]{4}$ ]]; then
	echo "ERROR: Invalid YEAR: $YEAR"
	echo "Expected a four-digit year, for example 2016."
	exit 1
fi

# DAY_OF_YEAR must be between 1 and 366.
if [[ ! "$DAY_OF_YEAR" =~ ^[0-9]{1,3}$ ]]; then
	echo "ERROR: Invalid DAY_OF_YEAR: $DAY_OF_YEAR"
	echo "Expected an integer between 1 and 366."
	exit 1
fi

# The 10# prefix prevents Bash from interpreting a leading zero as octal.
DAY_OF_YEAR_DECIMAL=$((10#$DAY_OF_YEAR))

if (( DAY_OF_YEAR_DECIMAL < 1 || DAY_OF_YEAR_DECIMAL > 366 )); then
	echo "ERROR: DAY_OF_YEAR is outside the valid range: $DAY_OF_YEAR"
	exit 1
fi


# Output some useful information about
# the job we are running
echo "Job identifier is $PBS_JOBID"
echo "Working directory is $PBS_O_WORKDIR"
echo "Start time: $(date)"
echo "Year : $YEAR"
echo "Day of year : $DAY_OF_YEAR_DECIMAL"

# Load the container we want to use
# It is a good idea to always specify the version number 
module purge
module load matlab/2024a

#matlab -nodisplay -nosplash <<'EOF'
#init_files_OSTIA(2025,001)
#init_all_biases(2025,001)
#exit
#EOF

matlab -batch "init_files_OSTIA(${YEAR},${DAY_OF_YEAR_DECIMAL});
init_all_biases(${YEAR},${DAY_OF_YEAR_DECIMAL});"

echo "OSTIA and bias initialisation completed successfully."
echo "End time: $(date)"
